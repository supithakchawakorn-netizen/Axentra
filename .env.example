# =============================================================================
# Varg Packs environment template
#
# Copy this file to .env.local and fill in real values for local development.
# Service-side keys (no NEXT_PUBLIC_* prefix) are NEVER bundled to the client.
# Public keys (NEXT_PUBLIC_*) ARE bundled to the client - never put a secret
# behind that prefix.
#
# Variables marked "M_n" are configured at the start of that milestone.
# =============================================================================

# -----------------------------------------------------------------------------
# Site identity (M0)
# -----------------------------------------------------------------------------
# Canonical site URL. Defaults to http://localhost:3000 in dev. Replace with
# your production domain (e.g. https://vargpacks.com) once decided.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only local UX iteration toggle. Set 1 to allow guest preview mode in dev.
# Ignored in production.
STUDIO_GUEST_MODE=0
# Server-only live kill-switch. Set 1 to pause creating new live rooms.
LIVE_BUILD_PAUSED=0
# Dev-only: allow unsigned users to create demo community posts (never enabled in production).
NEXT_PUBLIC_COMMUNITY_DEMO_POSTING=0
# Optional: trust-weighted feed blend toggle (0 = off, 1 = on).
FEED_TRUST_RANKING_ENABLED=0

# -----------------------------------------------------------------------------
# Supabase (M0 - required for the app to talk to the database / auth)
# Create a project at https://supabase.com/dashboard and paste the values
# from Settings -> API.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. SERVER ONLY. Used inside webhook + cron route handlers
# and trusted server scripts. Never reference from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# PostHog (M0 - optional; analytics no-ops if unset)
# Use the EU cloud (https://eu.posthog.com).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# -----------------------------------------------------------------------------
# Sentry (M0 - optional; error reporting no-ops if unset)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Mux (M1 - VOD upload + playback)
# -----------------------------------------------------------------------------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# -----------------------------------------------------------------------------
# Resend (M1 - transactional email; Supabase SMTP fallback in dev)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# LiveKit (M2 - live rooms)
# -----------------------------------------------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
LIVEKIT_WEBHOOK_SECRET=

# LiveKit Egress storage (S3-compatible: AWS S3 or Cloudflare R2)
LIVEKIT_EGRESS_BUCKET=
LIVEKIT_EGRESS_REGION=
LIVEKIT_EGRESS_ACCESS_KEY=
LIVEKIT_EGRESS_SECRET_KEY=
LIVEKIT_EGRESS_ENDPOINT=

# -----------------------------------------------------------------------------
# OpenAI (M3 - ticker / news summaries)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Cron (M3 - shared secret for /api/cron/* route handlers)
# -----------------------------------------------------------------------------
CRON_SECRET=
